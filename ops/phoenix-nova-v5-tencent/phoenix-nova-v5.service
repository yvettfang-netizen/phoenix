[Unit]
Description=Phoenix Nova website V5
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/phoenix-nova-v5/current/website/phoenix-nova-website-v5
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_MAIN_ORIGIN=https://phoenixnova.com.cn
Environment=PATH=/home/ubuntu/.nvm/versions/node/v24.20.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/.nvm/versions/node/v24.20.0/bin/node /home/ubuntu/phoenix-nova-v5/current/website/phoenix-nova-website-v5/node_modules/vinext/dist/cli.js start --hostname 127.0.0.1 --port 4315
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027
LimitNOFILE=65535
StandardOutput=journal
StandardError=journal
SyslogIdentifier=phoenix-nova-v5

[Install]
WantedBy=multi-user.target
