<view class="welcome">
  <view class="welcome__glow welcome__glow--one"></view>
  <view class="welcome__glow welcome__glow--two"></view>
  <view
    class="welcome__top"
    style="padding-top: {{navigation.statusBarHeight}}px; padding-right: {{navigation.menuButtonSafeWidth}}px; min-height: {{navigation.navigationBarHeight}}px;"
  ><brand-mark light="{{true}}" /></view>

  <view class="welcome__hero">
    <text class="welcome__eyebrow">FAMILY GROWTH, STEP BY STEP</text>
    <text class="welcome__title">陪伴家庭成长的
长期记录</text>
    <text class="welcome__subtitle">从 Education Compass 开始，记录家庭的重要选择，
让成长有方向，也有被理解的温度。</text>
    <view class="welcome__demo-note">当前为本地 Demo，仅使用虚构测试资料；数据不会提交到生产服务。</view>
  </view>

  <view class="orbit" aria-label="家庭成长关系环">
    <view class="orbit__ring orbit__ring--outer"></view>
    <view class="orbit__ring orbit__ring--inner"></view>
    <view class="orbit__core">
      <text class="orbit__small">MY FAMILY</text>
      <text class="orbit__big">OS</text>
      <text class="orbit__small">GROWTH CENTER</text>
    </view>
    <text class="orbit__label orbit__label--one">理解</text>
    <text class="orbit__label orbit__label--two">规划</text>
    <text class="orbit__label orbit__label--three">陪伴</text>
  </view>

  <view class="welcome__actions">
    <button class="btn btn--gold" loading="{{loading}}" disabled="{{loading}}" bindtap="start">进入家庭成长 Demo</button>
    <button class="welcome__login" disabled="{{loading}}" bindtap="start">使用本机已有 Demo 档案</button>
  </view>

  <view wx:if="{{showAdvisorEntry}}" class="welcome__footer" bindtap="advisorLogin">Phoenix Advisor 内部演示入口</view>
  <view class="safe-bottom"></view>
</view>
