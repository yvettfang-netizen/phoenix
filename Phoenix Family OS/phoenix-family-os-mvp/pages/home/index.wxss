.home { min-height: 100vh; }
.home__header { align-items: center; box-sizing: content-box; display: flex; justify-content: space-between; padding-bottom: 18rpx; padding-left: 32rpx; }
.home__hello { color: #6f7479; flex-shrink: 0; font-size: 22rpx; margin-left: 18rpx; max-width: 160rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.onboarding { background: linear-gradient(150deg, #102338, #0d1b2a); border-radius: 44rpx 44rpx 0 0; color: #fff; margin-top: 24rpx; min-height: calc(100vh - 150rpx); padding: 86rpx 44rpx 60rpx; }
.onboarding__title { display: block; font-family: "Songti SC", serif; font-size: 56rpx; font-weight: 700; line-height: 1.35; margin-top: 24rpx; white-space: pre-line; }
.onboarding__copy { color: rgba(255,255,255,.64); display: block; line-height: 1.8; margin: 34rpx 0 80rpx; }
.onboarding__progress { background: rgba(255,255,255,.12); border-radius: 10rpx; height: 6rpx; margin-bottom: 28rpx; overflow: hidden; }
.onboarding__progress-fill { background: #c8a24a; height: 100%; }
.family-hero { background: linear-gradient(145deg, #12283d, #0d1b2a); color: #fff; padding: 58rpx 36rpx 50rpx; }
.family-hero__label { color: #d1b778; display: block; font-size: 21rpx; letter-spacing: 3rpx; }
.family-hero__name { display: block; font-family: "Songti SC", serif; font-size: 55rpx; font-weight: 700; margin-top: 18rpx; }
.family-hero__goal { color: rgba(255,255,255,.7); display: block; font-family: serif; font-size: 27rpx; line-height: 1.7; margin-top: 18rpx; }
.family-hero__meta { color: rgba(255,255,255,.52); display: flex; font-size: 22rpx; margin-top: 30rpx; }
.family-hero__dot { margin: 0 12rpx; }
.home__body { padding-top: 0; }
.child-line { align-items: center; background: #fffdf9; border-bottom: 1rpx solid #e7dece; display: flex; padding: 30rpx 0; }
.child-line__avatar { align-items: center; background: #efe4cf; border-radius: 50%; color: #87662d; display: flex; font-family: serif; font-size: 30rpx; height: 78rpx; justify-content: center; margin-right: 22rpx; width: 78rpx; }
.child-line__label, .child-line__name, .child-line__stage { display: block; }
.child-line__label { color: #999188; font-size: 20rpx; }
.child-line__name { color: #0d1b2a; font-size: 30rpx; font-weight: 650; margin-top: 6rpx; }
.child-line__stage { color: #6f7479; font-size: 22rpx; margin-top: 4rpx; }
.insight-block { background: linear-gradient(155deg, #fffaf0, #f4ead7); border-radius: 30rpx; margin-top: 36rpx; padding: 32rpx; }
.insight-block__title { color: #0d1b2a; display: block; font-family: serif; font-size: 35rpx; font-weight: 700; margin-top: 7rpx; }
.insight-block__mark { color: #c8a24a; font-size: 50rpx; }
.insight-block__copy { color: #38424c; display: block; line-height: 1.8; }
.insight-block__notice { color: #7b7367; display: block; font-size: 22rpx; line-height: 1.6; margin-top: 18rpx; }
.insight-block__link { color: #9f762c; display: block; font-size: 24rpx; margin-top: 24rpx; }
.next-block { background: #fffdf9; border: 1rpx solid rgba(200,162,74,.24); border-radius: 28rpx; box-shadow: 0 16rpx 42rpx rgba(13,27,42,.05); margin-top: 36rpx; padding: 30rpx; }
.next-block__label, .next-block__title, .next-block__note { display: block; }
.next-block__label { color: #9f762c; font-size: 21rpx; letter-spacing: 3rpx; }
.next-block__title { color: #0d1b2a; font-family: serif; font-size: 34rpx; font-weight: 700; line-height: 1.5; margin-top: 12rpx; }
.next-block__note { color: #777; font-size: 24rpx; line-height: 1.6; margin-top: 8rpx; }
.next-block__line { background: #e9e1d5; height: 5rpx; margin-top: 22rpx; }
.next-block__line view { background: #c8a24a; height: 100%; }
.timeline-preview { align-items: center; background: #fffdf9; border-bottom: 1rpx solid #e7dece; border-top: 1rpx solid #e7dece; display: flex; gap: 22rpx; margin-top: 36rpx; padding: 26rpx 4rpx; }
.timeline-preview__title, .timeline-preview__meta { display: block; }
.timeline-preview__title { color: #0d1b2a; font-size: 28rpx; font-weight: 650; margin-top: 10rpx; }
.timeline-preview__meta { color: #746d62; font-size: 22rpx; line-height: 1.55; margin-top: 6rpx; }
.timeline-preview__arrow { color: #c8a24a; flex: 0 0 auto; font-family: serif; font-size: 44rpx; }
.home-links { border-top: 1rpx solid #e7dece; margin-top: 46rpx; }
.home-link { align-items: center; border-bottom: 1rpx solid #e7dece; display: flex; min-height: 100rpx; }
.home-link__number { color: #c8a24a; font-family: serif; font-size: 23rpx; margin-right: 22rpx; }
.home-link__title { color: #0d1b2a; flex: 1; font-weight: 600; }
.home-link__status { color: #746d62; flex: 0 0 auto; font-size: 21rpx; margin-right: 14rpx; }
