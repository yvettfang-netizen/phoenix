<view class="page page--paper advisor-page">
  <block wx:if="{{!submitted}}">
    <text class="eyebrow">ADVISOR SERVICE</text>
    <text class="h1 advisor-title">让洞察变成一次
有温度的讨论。</text>
    <text class="muted advisor-copy">需要把家庭记录放进真实生活语境时，可以在这里整理一次顾问对话需求。</text>
    <view class="advisor-demo-note">当前为本地 Demo：请求只保存在本机测试环境，不代表顾问已经收到，也不会触发真实联系。</view>

    <view class="advisor-profile">
      <view class="advisor-profile__avatar">P</view>
      <view><text class="advisor-profile__title">顾问服务</text><text class="advisor-profile__subtitle">洞察讨论 · 方向梳理 · 下一步规划</text></view>
    </view>

    <view class="field"><text class="field__label">希望讨论的主题</text><picker mode="selector" range="{{topics}}" value="{{topicIndex}}" bindchange="pickTopic"><view class="picker {{!form.topic ? 'placeholder' : ''}}">{{form.topic || '请选择'}}</view></picker></view>
    <view class="field"><text class="field__label">方便联系的时间</text><picker mode="selector" range="{{times}}" value="{{timeIndex}}" bindchange="pickTime"><view class="picker {{!form.preferred_time ? 'placeholder' : ''}}">{{form.preferred_time || '请选择'}}</view></picker></view>
    <view class="field"><text class="field__label">补充说明（选填）</text><textarea class="textarea" value="{{form.note}}" maxlength="300" placeholder="还有什么希望顾问提前了解？" bindinput="input"></textarea></view>
    <view class="form-actions"><button class="btn btn--primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">申请顾问联系</button></view>
  </block>

  <view wx:else class="success">
    <view class="success__mark">✓</view>
    <text class="h1 success__title">申请已记录</text>
    <text class="muted success__copy">本地演示请求已保存到家庭时间线；当前不会通知或分配真实顾问。</text>
    <button class="btn btn--primary success__btn" bindtap="done">完成</button>
  </view>
</view>
