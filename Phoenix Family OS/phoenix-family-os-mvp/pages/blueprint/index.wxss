.blueprint__cover { background: radial-gradient(circle at 86% 20%, rgba(200,162,74,.22), transparent 33%), linear-gradient(150deg, #10263b, #0b1927); color: #fff; min-height: 520rpx; overflow: hidden; padding: 70rpx 38rpx 46rpx; position: relative; }
.blueprint__cover::after { border: 1rpx solid rgba(200,162,74,.2); border-radius: 50%; content: ''; height: 460rpx; position: absolute; right: -220rpx; top: 20rpx; width: 460rpx; }
.blueprint__name { display: block; font-family: serif; font-size: 62rpx; font-weight: 700; line-height: 1.3; margin-top: 38rpx; position: relative; white-space: pre-line; z-index: 1; }
.blueprint__date { color: rgba(255,255,255,.55); display: block; font-size: 21rpx; margin-top: 28rpx; }
.blueprint__seal { align-items: center; border: 1rpx solid rgba(213,183,111,.45); border-radius: 50%; bottom: 45rpx; display: flex; flex-direction: column; height: 110rpx; justify-content: center; position: absolute; right: 45rpx; width: 110rpx; }
.blueprint__seal text:first-child { color: #e2c986; font-family: serif; font-size: 34rpx; }
.blueprint__seal text:last-child { color: rgba(255,255,255,.5); font-size: 13rpx; letter-spacing: 2rpx; }
.blueprint__body { background: #fffdf9; }
.blueprint__intro { border-bottom: 1rpx solid #e7dece; padding: 22rpx 0 42rpx; }
.blueprint__kicker, .blueprint-section__label { color: #a47b34; font-size: 19rpx; letter-spacing: 3rpx; }
.blueprint__kicker, .blueprint__title, .blueprint__copy { display: block; }
.blueprint__title { color: #0d1b2a; font-family: serif; font-size: 38rpx; font-weight: 700; line-height: 1.5; margin-top: 16rpx; }
.blueprint__copy { color: #5d6266; font-size: 26rpx; line-height: 1.8; margin-top: 16rpx; }
.blueprint-section { border-bottom: 1rpx solid #e7dece; padding: 40rpx 0; }
.blueprint-section__number { color: #c8a24a; float: right; font-family: serif; font-size: 26rpx; }
.blueprint-section__label, .blueprint-section__title, .blueprint-section__copy { display: block; }
.blueprint-section__title { color: #0d1b2a; font-family: serif; font-size: 35rpx; font-weight: 700; line-height: 1.5; margin-top: 14rpx; }
.blueprint-section__copy { color: #5d6266; font-size: 26rpx; line-height: 1.8; margin-top: 16rpx; }
.blueprint-chips { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.blueprint-chips text { background: #f5eee2; border-radius: 999rpx; color: #81622e; font-size: 21rpx; margin: 0 10rpx 10rpx 0; padding: 10rpx 14rpx; }
.blueprint-principle { background: #f5eee2; border-left: 5rpx solid #c8a24a; margin-top: 24rpx; padding: 22rpx; }
.blueprint-principle text { display: block; }
.blueprint-principle text:first-child, .blueprint-support text:first-child { color: #9a742f; font-size: 20rpx; letter-spacing: 2rpx; }
.blueprint-principle text:last-child { color: #38434d; font-size: 24rpx; line-height: 1.7; margin-top: 8rpx; }
.blueprint-support { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.blueprint-support text { border: 1rpx solid #dacbad; border-radius: 999rpx; color: #87662d; font-size: 21rpx; margin: 0 10rpx 10rpx 0; padding: 9rpx 14rpx; }
.blueprint-support text:first-child { border: 0; border-radius: 0; padding-left: 0; width: 100%; }
.blueprint-note { color: #9a958e; font-size: 20rpx; line-height: 1.6; margin-top: 28rpx; text-align: center; }
.blueprint-error { padding-top: 150rpx; text-align: center; }
.blueprint-error__title, .blueprint-error__copy { display: block; }
.blueprint-error__copy { margin-top: 20rpx; }
.blueprint-error__button { margin-top: 48rpx; }
