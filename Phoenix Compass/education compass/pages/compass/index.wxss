.compass-page {
  background:
    radial-gradient(circle at 86% 0%, rgba(221, 189, 125, .2), transparent 30%),
    linear-gradient(180deg, #fffdf9 0%, #fcf8f4 100%);
  min-height: 100vh;
}

.compass-hero {
  background:
    radial-gradient(circle at 84% 20%, rgba(221, 189, 125, .24), transparent 34%),
    linear-gradient(150deg, #fffdf9, #f8f0e5);
  border-bottom: 1rpx solid var(--line);
  min-height: 390rpx;
  overflow: hidden;
  padding: 56rpx 40rpx 50rpx;
  position: relative;
}

.compass-hero > .row,
.compass-hero > text,
.compass-hero__student {
  max-width: 76%;
  position: relative;
  z-index: 1;
}

.compass-hero__feather {
  height: 570rpx;
  opacity: .15;
  pointer-events: none;
  position: absolute;
  right: -210rpx;
  top: -110rpx;
  transform: rotate(17deg);
  width: 390rpx;
}

.compass-hero__compass {
  height: 226rpx;
  opacity: .34;
  pointer-events: none;
  position: absolute;
  right: -18rpx;
  top: 110rpx;
  width: 226rpx;
}

.compass-hero__title {
  color: var(--navy);
  display: block;
  font-family: var(--font-display);
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.42;
  margin-top: 24rpx;
  white-space: pre-line;
}

.compass-hero__copy {
  color: var(--ink-secondary);
  display: block;
  font-size: 25rpx;
  line-height: 1.8;
  margin-top: 24rpx;
}

.compass-hero__student {
  align-items: center;
  border-top: 1rpx solid rgba(137, 88, 12, .16);
  display: flex;
  margin-top: 34rpx;
  padding-top: 28rpx;
}

.compass-hero__avatar {
  align-items: center;
  background: linear-gradient(145deg, #1a2d43, #102033);
  border: 1rpx solid rgba(221, 189, 125, .4);
  border-radius: 50%;
  color: #f0d99e;
  display: flex;
  font-family: var(--font-display);
  height: 72rpx;
  justify-content: center;
  margin-right: 18rpx;
  width: 72rpx;
}

.compass-hero__name,
.compass-hero__meta {
  display: block;
}

.compass-hero__name {
  color: var(--navy);
  font-weight: 650;
}

.compass-hero__meta {
  color: var(--muted);
  font-size: 22rpx;
  line-height: 1.5;
  margin-top: 5rpx;
}

.compass-body {
  padding-top: 38rpx;
}

.compass-state {
  align-items: center;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 48vh;
  text-align: center;
}

.compass-state__compass {
  height: 116rpx;
  margin-bottom: 26rpx;
  opacity: .74;
  pointer-events: none;
  width: 116rpx;
}

.compass-state .muted {
  margin: 18rpx 0 28rpx;
  max-width: 560rpx;
}

.compass-path {
  background: rgba(255, 253, 249, .88);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 30rpx;
  overflow: hidden;
  padding: 10rpx 28rpx;
}

.compass-path__item {
  display: flex;
  min-height: 116rpx;
  padding: 24rpx 0;
  position: relative;
}

.compass-path__item + .compass-path__item {
  border-top: 1rpx solid var(--line);
}

.compass-path__item > text {
  align-items: center;
  background: var(--gold-wash);
  border: 1rpx solid var(--line-strong);
  border-radius: 50%;
  color: var(--gold-deep);
  display: flex;
  flex: 0 0 58rpx;
  font-family: var(--font-display);
  font-size: 20rpx;
  height: 58rpx;
  justify-content: center;
  margin-right: 22rpx;
  margin-top: 2rpx;
}

.compass-path__item view {
  min-width: 0;
}

.compass-path__item view text {
  display: block;
}

.compass-path__item view text:first-child {
  color: var(--navy);
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1.5;
}

.compass-path__item view text:last-child {
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.65;
  margin-top: 7rpx;
}

.compass-time {
  color: var(--muted);
  display: block;
  font-size: 21rpx;
  line-height: 1.6;
  margin-top: 22rpx;
  text-align: center;
}

.history {
  border-top: 1rpx solid var(--line);
  padding-top: 36rpx;
}

.history__item {
  align-items: center;
  background: rgba(255, 253, 249, .8);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-md);
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  min-height: 104rpx;
  padding: 22rpx 24rpx;
}

.history__item:active {
  background: var(--gold-wash);
}

.history__date,
.history__title {
  display: block;
}

.history__date {
  color: var(--gold-deep);
  font-size: 20rpx;
}

.history__title {
  color: var(--navy);
  font-size: 27rpx;
  line-height: 1.5;
  margin-top: 6rpx;
}

.demo-badge {
  background: rgba(255, 253, 249, .8);
  border: 1rpx solid var(--line-strong);
  border-radius: 999rpx;
  color: var(--gold-deep);
  font-size: 19rpx;
  padding: 8rpx 14rpx;
}

.product-card {
  background:
    radial-gradient(circle at 92% 0%, rgba(221, 189, 125, .28), transparent 34%),
    linear-gradient(145deg, #1a2d43, #102033);
  border: 1rpx solid rgba(221, 189, 125, .22);
  border-radius: var(--radius-card);
  box-shadow: 0 18rpx 44rpx rgba(20, 36, 58, .12);
  color: white;
  margin-bottom: 30rpx;
  overflow: hidden;
  padding: 32rpx;
  position: relative;
}

.product-card::after {
  background: radial-gradient(circle, rgba(226, 194, 125, .28), transparent 70%);
  border-radius: 50%;
  content: "";
  height: 190rpx;
  opacity: .1;
  pointer-events: none;
  position: absolute;
  right: -40rpx;
  top: 8rpx;
  width: 190rpx;
}

.product-card .row,
.product-card__note {
  position: relative;
  z-index: 1;
}

.product-card__label,
.product-card__price,
.product-card__note {
  display: block;
}

.product-card__label {
  color: rgba(255, 255, 255, .72);
  font-size: 21rpx;
}

.product-card__price {
  color: #efd596;
  font-family: var(--font-display);
  font-size: 52rpx;
  font-weight: 700;
  margin-top: 8rpx;
}

.product-card__type {
  border: 1rpx solid rgba(239, 213, 150, .45);
  border-radius: 999rpx;
  color: #efd596;
  font-size: 20rpx;
  padding: 9rpx 15rpx;
}

.product-card__note {
  color: rgba(255, 255, 255, .72);
  font-size: 21rpx;
  line-height: 1.72;
  margin-top: 18rpx;
  max-width: 90%;
}

.compass-entry-note {
  background: rgba(250, 244, 233, .82);
  border: 1rpx solid rgba(185, 134, 45, .18);
  border-radius: var(--radius-md);
  color: var(--ink-secondary);
  font-size: 22rpx;
  line-height: 1.7;
  margin: -6rpx 0 28rpx;
  padding: 22rpx 24rpx;
}

.compass-entry-note__label {
  color: var(--gold-deep);
  display: block;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 1.2rpx;
  margin-bottom: 5rpx;
}

.consent-card {
  background: rgba(255, 253, 249, .9);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  margin-bottom: 24rpx;
  padding: 30rpx;
}

.consent-card .h3 {
  margin-bottom: 16rpx;
}

.consent-row {
  align-items: center;
  box-sizing: border-box;
  color: var(--ink-secondary);
  display: flex;
  font-size: 23rpx;
  line-height: 1.68;
  min-height: 88rpx;
  padding: 10rpx 0;
}

.consent-row--divided {
  border-top: 1rpx solid var(--line);
}

.consent-row__copy {
  flex: 1;
  min-width: 0;
}

.consent-row checkbox {
  flex: none;
  margin-right: 13rpx;
  transform: scale(.86);
}

.text-link {
  color: var(--gold-deep);
  text-decoration: underline;
}

.consent-copy {
  color: var(--ink-secondary);
  display: block;
  font-size: 23rpx;
  line-height: 1.76;
  margin-bottom: 16rpx;
}

.consent-row--touch {
  border-top: 1rpx solid var(--line);
  padding: 12rpx 0;
}

.consent-link {
  align-items: center;
  display: inline-flex;
  min-height: 88rpx;
}

.consent-card--student {
  background: linear-gradient(145deg, #fffdf9, #f2f7f6);
  border-color: #d7e3e0;
}

@media (max-width: 360px) {
  .compass-hero {
    padding-left: 30rpx;
    padding-right: 30rpx;
  }

  .compass-hero > .row,
  .compass-hero > text,
  .compass-hero__student {
    max-width: 82%;
  }

  .compass-hero__title {
    font-size: 43rpx;
  }

  .compass-hero__compass {
    opacity: .22;
    right: -58rpx;
  }

  .product-card {
    padding: 28rpx;
  }

  .product-card__price {
    font-size: 45rpx;
  }

  .compass-path {
    padding-left: 22rpx;
    padding-right: 22rpx;
  }
}

/* Education Compass V2 landing presentation. Business state remains page-owned. */
.compass-page {
  overflow: hidden;
  padding-bottom: env(safe-area-inset-bottom);
  position: relative;
}

.compass-page__feather {
  opacity: .16;
  pointer-events: none;
  position: absolute;
  width: 500rpx;
  z-index: 0;
}

.compass-page__feather--top { right: -190rpx; top: 10rpx; transform: rotate(16deg); }
.compass-page__feather--bottom { bottom: -190rpx; left: -210rpx; transform: rotate(188deg); }

.compass-brand {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin: 0 auto;
  max-width: 750rpx;
  padding: 32rpx 36rpx 18rpx;
  position: relative;
  z-index: 2;
}

.compass-brand__logo { display: block; height: auto; width: 292rpx; }

.compass-product-lockup {
  align-items: center;
  color: #a36f1e;
  display: flex;
  justify-content: center;
  margin: 26rpx auto 0;
  position: relative;
  z-index: 2;
}

.compass-product-lockup image { height: 56rpx; margin-right: 12rpx; width: 56rpx; }
.compass-product-lockup view { display: flex; flex-direction: column; text-align: left; }
.compass-product-lockup text { display: block; font-family: var(--font-display); font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.compass-product-lockup text:last-child { color: #8d8579; font-family: var(--font-body); font-size: 14rpx; font-weight: 600; letter-spacing: 1.5rpx; margin-top: 3rpx; }

.compass-hero {
  background: transparent;
  border: 0;
  min-height: 0;
  overflow: visible;
  padding: 34rpx 36rpx 36rpx;
  text-align: center;
}

.compass-hero__compass {
  height: 300rpx;
  left: 50%;
  opacity: .12;
  right: auto;
  top: 0;
  transform: translateX(-50%);
  width: 300rpx;
}

.compass-hero > .eyebrow,
.compass-hero > .compass-hero__title,
.compass-hero > .compass-hero__copy,
.compass-hero__student {
  margin-left: auto;
  margin-right: auto;
  max-width: 650rpx;
}

.compass-hero > .eyebrow { font-size: 20rpx; letter-spacing: 3rpx; position: relative; z-index: 1; }

.compass-hero__title {
  font-size: 58rpx;
  line-height: 1.34;
  margin-top: 24rpx;
  position: relative;
  white-space: pre-line;
  z-index: 1;
}

.compass-hero__copy {
  font-size: 25rpx;
  line-height: 1.76;
  margin-top: 24rpx;
  position: relative;
  z-index: 1;
}

.compass-benefits {
  background: rgba(255,253,249,.82);
  border: 1rpx solid rgba(185,134,45,.17);
  border-radius: 26rpx;
  box-shadow: 0 14rpx 40rpx rgba(59,42,18,.055);
  display: flex;
  margin: 34rpx auto 0;
  max-width: 650rpx;
  padding: 22rpx 8rpx;
  position: relative;
  z-index: 1;
}

.compass-benefit { display: flex; flex: 1; flex-direction: column; min-width: 0; padding: 2rpx 10rpx; text-align: center; }
.compass-benefit + .compass-benefit { border-left: 1rpx solid rgba(183,129,34,.15); }
.compass-benefit__value { color: #a36d18; font-family: var(--font-display); font-size: 30rpx; font-weight: 700; line-height: 1.35; }
.compass-benefit__label { color: #716c65; font-size: 18rpx; line-height: 1.45; margin-top: 6rpx; }

.compass-hero__student {
  background: rgba(255,253,249,.72);
  border: 1rpx solid rgba(185,134,45,.14);
  border-radius: 22rpx;
  justify-content: flex-start;
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  text-align: left;
}

.compass-hero__avatar { height: 64rpx; width: 64rpx; }

.compass-body {
  margin: 0 auto;
  max-width: 750rpx;
  padding-bottom: calc(72rpx + env(safe-area-inset-bottom));
  padding-top: 18rpx;
  position: relative;
  z-index: 1;
}

.compass-state { min-height: 360rpx; }

.product-card {
  background: linear-gradient(145deg, #fff6e5, #f4dfb6);
  border-color: rgba(177,119,22,.28);
  color: #102238;
  padding: 28rpx 30rpx;
}

.product-card__label { color: #806b49; }
.product-card__price { color: #9c6814; }
.product-card__type { border-color: rgba(156,104,20,.35); color: #865b17; }
.product-card__note { color: #685f52; max-width: 100%; }

.compass-path { margin-bottom: 24rpx; }
.compass-path__item { min-height: 104rpx; padding: 20rpx 0; }
.compass-path__item view text:first-child { font-size: 27rpx; }
.compass-path__item view text:last-child { font-size: 22rpx; }

.consent-card { padding: 28rpx; }

.consent-card__heading { align-items: center; display: flex; margin-bottom: 18rpx; }
.consent-card__heading view { min-width: 0; }
.consent-card__heading .h3 { margin-bottom: 0; }
.consent-card__heading view > text:last-child { color: #837c72; display: block; font-size: 19rpx; line-height: 1.5; margin-top: 4rpx; }
.consent-card__step { align-items: center; background: #f8ead0; border: 1rpx solid #d9b56f; border-radius: 50%; color: #95651a; display: flex; flex: 0 0 54rpx; font-family: var(--font-display); font-size: 19rpx; height: 54rpx; justify-content: center; margin-right: 16rpx; }

.compass-primary {
  background: linear-gradient(105deg, #d9af48 0%, #c99217 56%, #b77a0b 100%);
  box-shadow: 0 14rpx 32rpx rgba(172,113,13,.24);
  color: #fffdf8;
  min-height: 104rpx;
}

.compass-privacy { align-items: center; color: #898279; display: flex; font-size: 21rpx; justify-content: center; line-height: 1.55; margin: 20rpx auto 0; min-height: 88rpx; text-align: center; }
.compass-privacy__mark { color: #ac7a27; font-size: 25rpx; margin-right: 10rpx; }

@media (max-width: 360px) {
  .compass-brand { padding-left: 24rpx; padding-right: 24rpx; }
  .compass-brand__logo { width: 250rpx; }
  .compass-hero { padding-left: 24rpx; padding-right: 24rpx; }
  .compass-hero > .eyebrow,
  .compass-hero > .compass-hero__title,
  .compass-hero > .compass-hero__copy,
  .compass-hero__student { max-width: 100%; }
  .compass-hero__title { font-size: 48rpx; }
  .compass-benefits { margin-top: 28rpx; }
  .compass-benefit { padding-left: 5rpx; padding-right: 5rpx; }
  .compass-benefit__value { font-size: 26rpx; }
  .compass-benefit__label { font-size: 17rpx; }
  .compass-body { padding-left: 24rpx; padding-right: 24rpx; }
}

@media (max-width: 340px) {
  .compass-brand__logo { width: 226rpx; }
  .compass-product-lockup { margin-top: 20rpx; }
  .compass-hero__title { font-size: 44rpx; }
  .compass-hero__copy { font-size: 23rpx; }
  .consent-card { padding: 24rpx 22rpx; }
}

/* 问卷记录（mode=records） */
.records { background: rgba(255,253,249,.94); border: 1rpx solid rgba(183,132,39,.15); border-radius: 28rpx; padding: 30rpx; }
.records .section-head { align-items: center; margin-bottom: 8rpx; }
.records__empty { border-top: 1rpx solid #eee4d4; color: #6f6a63; display: flex; flex-direction: column; font-size: 23rpx; gap: 20rpx; padding-top: 24rpx; }
.readiness-hint { background: linear-gradient(180deg,#fffdf7 0%,#fdf5e6 100%); border: 1rpx solid rgba(183,132,39,.2); border-left: 6rpx solid #c8a256; border-radius: 22rpx; display: flex; flex-direction: column; gap: 12rpx; margin: 18rpx 0 10rpx; padding: 24rpx 24rpx 22rpx; }
.readiness-hint__eyebrow { color: #9a7b3c; font-size: 19rpx; letter-spacing: .16em; }
.readiness-hint__title { color: #172a3d; font-size: 27rpx; font-weight: 600; line-height: 1.4; }
.readiness-hint__copy { color: #6f6a63; font-size: 22rpx; line-height: 1.7; }
button.readiness-hint__action { box-sizing: border-box; margin-top: 6rpx; width: 100%; }
.record { border-top: 1rpx solid #eee4d4; padding: 22rpx 0; }
.record__title, .record__meta, .record__note { display: block; }
.record__title { color: #172a3d; font-size: 26rpx; font-weight: 600; }
.record__meta { color: #887f74; font-size: 21rpx; margin-top: 8rpx; }
.record__note { color: #873f37; font-size: 21rpx; line-height: 1.6; margin-top: 10rpx; }
.record__actions { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.record__action { background: #fffdf9; border: 1rpx solid #ded2c1; border-radius: 999rpx; color: #2d4052; font-size: 22rpx; line-height: 1.2; padding: 14rpx 24rpx; }
.record__action::after { border: 0; }
.record__action--critical { background: #fffaf7; border-color: rgba(145,67,57,.22); color: #873f37; }
.record__action[disabled] { background: #f4f0e9; color: #8b867e; opacity: .72; }

/* 免费教育初评（匿名 12 题 + 四卡即时快照）
   与结果页同一套材质：象牙纸底、香槟金细线、宋体标题、卡片投影。 */
.free-education {
  background:
    radial-gradient(circle at 92% -8%, rgba(221, 189, 125, .26), transparent 38%),
    radial-gradient(circle at 2% 46%, rgba(221, 189, 125, .1), transparent 30%),
    linear-gradient(180deg, #fffdf9 0%, #fbf6ee 62%, #f8f0e4 100%);
  color: var(--navy);
  overflow: hidden;
  padding: 26rpx 32rpx calc(72rpx + env(safe-area-inset-bottom));
  position: relative;
}

.free-education__feather {
  opacity: .14;
  pointer-events: none;
  position: absolute;
  right: -180rpx;
  top: 360rpx;
  transform: rotate(18deg);
  width: 440rpx;
  z-index: 0;
}

.free-education__body {
  margin: 0 auto;
  max-width: 750rpx;
  position: relative;
  z-index: 1;
}

.free-education__brand {
  align-items: center;
  display: flex;
  justify-content: space-between;
  padding: 4rpx 0 30rpx;
}

.free-education__logo { display: block; height: auto; width: 236rpx; }

.free-education__lockup { text-align: right; }

.free-education__lockup-name,
.free-education__lockup-sub { display: block; }

.free-education__lockup-name {
  color: #a36f1e;
  font-family: var(--font-display);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 1.8rpx;
}

.free-education__lockup-sub {
  color: #9a9184;
  font-size: 14rpx;
  letter-spacing: 1.4rpx;
  margin-top: 4rpx;
}

.free-education__eyebrow {
  color: #a47527;
  display: block;
  font-size: 19rpx;
  font-weight: 650;
  letter-spacing: 3rpx;
}

.free-education__display {
  color: var(--navy);
  display: block;
  font-family: var(--font-display);
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1.36;
  margin-top: 18rpx;
  white-space: pre-line;
}

.free-education__lede {
  color: #56616d;
  display: block;
  font-size: 24rpx;
  line-height: 1.85;
  margin-top: 20rpx;
}

.free-education__roles { margin-top: 32rpx; }

button.free-education__role-card {
  background: rgba(255, 253, 249, .95);
  border: 1rpx solid var(--line);
  border-radius: 24rpx;
  box-shadow: 0 14rpx 38rpx rgba(59, 42, 18, .055);
  height: auto;
  margin: 0 0 14rpx;
  min-height: 132rpx;
  padding: 22rpx 22rpx 22rpx 24rpx;
  width: 100%;
}

.free-education__role-card:active {
  background: linear-gradient(145deg, #fff8ea, #fdf0da);
  border-color: #dcbd8a;
}

.free-education__role-inner {
  align-items: center;
  display: flex;
  text-align: left;
  width: 100%;
}

.free-education__role-mark {
  align-items: center;
  background: radial-gradient(circle at 34% 28%, #fffdf8, #f3e3c5);
  border: 1rpx solid #dcc08d;
  border-radius: 50%;
  color: #966313;
  display: flex;
  flex: 0 0 74rpx;
  font-family: var(--font-display);
  font-size: 27rpx;
  height: 74rpx;
  justify-content: center;
  margin-right: 20rpx;
  width: 74rpx;
}

.free-education__role-copy { flex: 1; min-width: 0; }

.free-education__role-title {
  color: var(--navy);
  display: block;
  font-size: 28rpx;
  font-weight: 650;
  line-height: 1.45;
}

.free-education__role-note {
  color: #85817a;
  display: block;
  font-size: 21rpx;
  line-height: 1.6;
  margin-top: 6rpx;
}

.free-education__role-arrow {
  color: #b98b34;
  flex: none;
  font-family: var(--font-display);
  font-size: 30rpx;
  margin-left: 10rpx;
}

.free-education__brand--compact { padding: 0 0 16rpx; }
.free-education__brand--compact .free-education__logo { width: 152rpx; }
.free-education__brand--compact .free-education__lockup-name { display: none; }
.free-education__brand--compact .free-education__lockup-sub { color: #a47527; font-size: 15rpx; letter-spacing: 1.6rpx; }

.free-education__preview {
  border-top: 1rpx solid #ecdfca;
  margin-top: 34rpx;
  padding-top: 26rpx;
}

.free-education__preview-title {
  color: #8a6a2f;
  display: block;
  font-size: 19rpx;
  font-weight: 650;
  letter-spacing: 2rpx;
}

.free-education__preview-grid {
  display: grid;
  gap: 12rpx;
  grid-template-columns: 1fr 1fr;
  margin-top: 16rpx;
}

.free-education__preview-tile {
  align-items: baseline;
  background: rgba(255, 253, 249, .72);
  border: 1rpx solid #ebdfcd;
  border-radius: 16rpx;
  display: flex;
  padding: 18rpx;
}

.free-education__preview-index {
  color: #c19a52;
  flex: none;
  font-family: var(--font-display);
  font-size: 17rpx;
  margin-right: 12rpx;
}

.free-education__preview-name { color: #2b3d50; font-size: 24rpx; font-weight: 600; }

.free-education__assurance {
  align-items: flex-start;
  display: flex;
  margin-top: 22rpx;
  padding: 0 6rpx;
}

.free-education__assurance-mark { color: #b98b34; font-size: 20rpx; margin-right: 10rpx; }

.free-education__assurance-copy { color: #8b857c; flex: 1; font-size: 20rpx; line-height: 1.6; }

.free-education__progress-head {
  align-items: center;
  display: flex;
  justify-content: space-between;
}

.free-education__progress-label {
  color: #8a6a2f;
  font-size: 21rpx;
  font-weight: 650;
  letter-spacing: 1.6rpx;
}

.free-education__progress-hint {
  border: 1rpx solid #e4d3b4;
  border-radius: 999rpx;
  color: #9a8f7d;
  font-size: 18rpx;
  padding: 5rpx 14rpx;
}

.free-education__track {
  background: #efe4d1;
  border-radius: 999rpx;
  height: 6rpx;
  margin-top: 14rpx;
  overflow: hidden;
}

.free-education__track-fill {
  background: linear-gradient(90deg, #e3c684, #b98426);
  border-radius: 999rpx;
  height: 100%;
  transition: width .3s ease;
}

.free-education__question {
  background: rgba(255, 253, 249, .96);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  box-shadow: 0 16rpx 44rpx rgba(59, 42, 18, .06);
  margin-top: 26rpx;
  overflow: hidden;
  padding: 30rpx 28rpx 32rpx;
  position: relative;
}

.free-education__question::after {
  background: radial-gradient(circle, rgba(221, 189, 125, .3), transparent 70%);
  border-radius: 50%;
  content: "";
  height: 190rpx;
  pointer-events: none;
  position: absolute;
  right: -70rpx;
  top: -60rpx;
  width: 190rpx;
}

.free-education__question-kicker,
.free-education__question-prompt { display: block; position: relative; z-index: 1; }

.free-education__question-kicker {
  color: #a47527;
  font-size: 18rpx;
  font-weight: 650;
  letter-spacing: 2.4rpx;
}

.free-education__question-prompt {
  color: var(--navy);
  font-family: var(--font-display);
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1.52;
  margin-top: 14rpx;
}

.free-education__options { margin-top: 24rpx; }

button.free-education__option {
  background: rgba(255, 253, 249, .92);
  border: 1rpx solid #e9dfcf;
  border-radius: 18rpx;
  color: var(--navy);
  height: auto;
  margin: 0 0 12rpx;
  min-height: 100rpx;
  padding: 20rpx;
  width: 100%;
}

.free-education__option-inner {
  align-items: center;
  display: flex;
  text-align: left;
  width: 100%;
}

.free-education__option-mark {
  align-items: center;
  border: 1rpx solid #ddc9a5;
  border-radius: 50%;
  color: #a6813c;
  display: flex;
  flex: 0 0 50rpx;
  font-family: var(--font-display);
  font-size: 21rpx;
  height: 50rpx;
  justify-content: center;
  margin-right: 18rpx;
  transition: background .18s ease, color .18s ease;
  width: 50rpx;
}

.free-education__option-mark--multi { border-radius: 12rpx; }

.free-education__option-label {
  color: #25384c;
  flex: 1;
  font-size: 26rpx;
  line-height: 1.55;
  min-width: 0;
}

.free-education__option--selected {
  background: linear-gradient(145deg, #fff8ea, #fbedd2);
  border-color: #cf9f47;
  box-shadow: 0 10rpx 26rpx rgba(177, 119, 22, .13);
}

.free-education__option--selected .free-education__option-mark {
  background: linear-gradient(145deg, #d9af48, #b77a0b);
  border-color: transparent;
  color: #fffdf8;
}

.free-education__option--selected .free-education__option-label { color: #7c5310; font-weight: 600; }

.free-education__option[disabled] { background: #f4f0e8; border-color: #e7dfd2; opacity: 1; }
.free-education__option[disabled] .free-education__option-label { color: #9a9389; }
.free-education__option[disabled] .free-education__option-mark { border-color: #e0d6c5; color: #b3aa9c; }

.free-education__controls {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

button.free-education__back {
  background: transparent;
  border: 1rpx solid #ded0ba;
  border-radius: 50%;
  color: #7e6a4a;
  flex: 0 0 88rpx;
  font-size: 30rpx;
  height: 88rpx;
  margin: 0;
  min-height: 88rpx;
  padding: 0;
  width: 88rpx;
}

button.free-education__skip {
  background: transparent;
  border: 1rpx solid #e3d6c1;
  border-radius: 999rpx;
  color: #857a68;
  flex: none;
  font-size: 22rpx;
  height: 88rpx;
  margin: 0;
  min-height: 88rpx;
  padding: 0 22rpx;
  width: auto;
}

button.free-education__continue {
  background: linear-gradient(105deg, #d9af48 0%, #c99217 56%, #b77a0b 100%);
  border: 0;
  border-radius: 999rpx;
  box-shadow: 0 14rpx 32rpx rgba(172, 113, 13, .24);
  color: #fffdf8;
  flex: 1;
  font-size: 27rpx;
  font-weight: 650;
  height: 92rpx;
  margin: 0;
  min-height: 92rpx;
  padding: 0 24rpx;
}

.free-education__continue[disabled] {
  background: #e7e0d4;
  box-shadow: none;
  color: #8b8377;
}

.free-education__footnote {
  color: #8b857c;
  display: block;
  font-size: 20rpx;
  line-height: 1.65;
  margin-top: 16rpx;
}

.free-education__footnote--center { text-align: center; }

.free-education__error {
  background: #fdf2ef;
  border: 1rpx solid rgba(152, 75, 64, .18);
  border-radius: 16rpx;
  color: var(--danger);
  display: block;
  font-size: 22rpx;
  line-height: 1.6;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
}

.free-education__snapshot { margin-top: 4rpx; }

.free-education__snapshot-head { padding: 0 4rpx; }

.free-education__meta {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.free-education__meta-item {
  background: rgba(255, 253, 249, .9);
  border: 1rpx solid #e8dcc8;
  border-radius: 999rpx;
  color: #7d6a4a;
  font-size: 18rpx;
  padding: 7rpx 15rpx;
}

.free-education__meta-dot { color: #c2a273; margin: 0 8rpx; }

.free-education__cards { margin-top: 24rpx; }

.free-education__card {
  background: rgba(255, 253, 249, .96);
  border: 1rpx solid var(--line);
  border-radius: 26rpx;
  box-shadow: 0 14rpx 40rpx rgba(59, 42, 18, .055);
  margin-top: 16rpx;
  overflow: hidden;
  padding: 24rpx 26rpx 8rpx;
  position: relative;
}

.free-education__card:last-child {
  background: linear-gradient(150deg, #fffdf8 0%, #fbf1df 100%);
  border-color: #e3cda6;
}

.free-education__card-head {
  align-items: center;
  border-bottom: 1rpx solid #f0e7d8;
  display: flex;
  padding-bottom: 16rpx;
}

.free-education__card-index {
  align-items: center;
  border: 1rpx solid #dcc08d;
  border-radius: 50%;
  color: #966313;
  display: flex;
  flex: 0 0 50rpx;
  font-family: var(--font-display);
  font-size: 18rpx;
  height: 50rpx;
  justify-content: center;
  margin-right: 16rpx;
  width: 50rpx;
}

.free-education__card-label {
  color: var(--navy);
  font-family: var(--font-display);
  font-size: 31rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.free-education__card-empty {
  color: #8b857c;
  display: block;
  font-size: 22rpx;
  line-height: 1.65;
  padding: 20rpx 0 22rpx;
}

.free-education__finding { padding: 20rpx 0; }
.free-education__finding + .free-education__finding { border-top: 1rpx solid #f2ebdf; }

.free-education__finding-title {
  color: #1b2f45;
  display: block;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1.5;
}

.free-education__finding-copy {
  color: #4d5a66;
  display: block;
  font-size: 23rpx;
  line-height: 1.75;
  margin-top: 8rpx;
}

.free-education__evidence {
  align-items: center;
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.free-education__evidence-level {
  background: #f5eddf;
  border: 1rpx solid #e8dcc6;
  border-radius: 999rpx;
  color: #8a6a2f;
  font-size: 17rpx;
  padding: 5rpx 12rpx;
}

.free-education__evidence-ref {
  background: #fffdf9;
  border: 1rpx solid #eee2cd;
  border-radius: 999rpx;
  color: #9a8f7d;
  font-size: 17rpx;
  margin-left: 8rpx;
  padding: 5rpx 11rpx;
}

.free-education__actions { margin-top: 12rpx; }

.free-education__action { align-items: flex-start; display: flex; padding: 2rpx 0; }
.free-education__action-mark { color: #bd8a32; flex: none; font-size: 20rpx; line-height: 1.7; margin-right: 10rpx; }
.free-education__action-text { color: #6b5a3c; flex: 1; font-size: 21rpx; line-height: 1.7; }

.free-education__snapshot-foot { margin-top: 26rpx; }

button.free-education__revisit {
  background: rgba(255, 253, 249, .9);
  border: 1rpx solid #d8b66d;
  border-radius: 999rpx;
  color: #966313;
  font-size: 26rpx;
  font-weight: 600;
  height: 96rpx;
  margin: 0;
  min-height: 96rpx;
  width: 100%;
}

@media (max-width: 360px) {
  .free-education { padding-left: 24rpx; padding-right: 24rpx; }
  .free-education__logo { width: 208rpx; }
  .free-education__lockup-name { font-size: 16rpx; letter-spacing: 1.2rpx; }
  .free-education__lockup-sub { font-size: 12rpx; letter-spacing: 1rpx; }
  .free-education__display { font-size: 48rpx; }
  .free-education__lede { font-size: 23rpx; }
  button.free-education__role-card { padding: 20rpx; }
  .free-education__role-mark { flex-basis: 66rpx; font-size: 24rpx; height: 66rpx; margin-right: 16rpx; width: 66rpx; }
  .free-education__role-title { font-size: 27rpx; }
  .free-education__question { padding: 26rpx 22rpx 28rpx; }
  .free-education__question-prompt { font-size: 35rpx; }
  button.free-education__option { padding: 18rpx; }
  .free-education__option-mark { flex-basis: 46rpx; font-size: 19rpx; height: 46rpx; margin-right: 14rpx; width: 46rpx; }
  .free-education__option-label { font-size: 25rpx; }
  .free-education__card { padding: 22rpx 20rpx 6rpx; }
  .free-education__card-label { font-size: 28rpx; }
  .free-education__finding-copy { font-size: 22rpx; }
  .free-education__brand--compact .free-education__logo { width: 136rpx; }
  .free-education__preview-tile { padding: 16rpx; }
  .free-education__preview-name { font-size: 23rpx; }
}
