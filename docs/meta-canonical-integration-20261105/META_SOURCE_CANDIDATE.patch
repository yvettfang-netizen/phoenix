+import test from 'node:test';import assert from 'node:assert/strict';import {registerHooks} from 'node:module';
+registerHooks({resolve(specifier,context,next){try{return next(specifier,context)}catch(e){if(specifier.startsWith('.')&&!specifier.endsWith('.ts'))return next(specifier+'.ts',context);throw e}}});
+const {guardianSystem}=await import('../app/guardian-system.ts');
+const {spiritPresentation,founderFreeze}=await import('../app/spirit-freeze.ts');
+const {existingMemberRoles,memberSpiritAccess}=await import('../lib/meta-members.ts');
+const {default:worker}=await import('../dist/server/index.js');
+const env={ASSETS:{fetch:async()=>new Response('',{status:404})}};const ctx={waitUntil(){}};
+const founder={'oai-authenticated-user-id':'synthetic-founder','oai-authenticated-user-email':Object.keys(existingMemberRoles).find(email=>existingMemberRoles[email]==='FOUNDER')};
+const limited={'oai-authenticated-user-id':'synthetic-limited','oai-authenticated-user-email':Object.keys(memberSpiritAccess).find(email=>memberSpiritAccess[email].includes('xuanwu')&&!memberSpiritAccess[email].includes('pixiu'))};
+const get=(path,headers={})=>worker.fetch(new Request('http://localhost'+path,{headers:{accept:'text/html',...headers}}),env,ctx);
+test('formal nine identities, unique numbering, domains and spaces match current freeze',()=>{
+ const expected=[['phoenix','01','天枢宫','NOVA'],['qinglong','02','经纬殿','NEXUS'],['zhuque','03','丹青岛','MUSE'],['xuanwu','04','玄机渊','DEEPCORE'],['qingluan','05','鸾音谷','ECHO'],['baihu','06','守正关','INTEGRITY'],['qilin','07','和序原','HARMONY'],['aoyu','08','问思洲','ASKWISE'],['pixiu','09','承泽川','LEGACY']];
+ assert.equal(guardianSystem.length,9);assert.equal(founderFreeze.date,'2026-09-20');
+ for(const [id,no,space,ability]of expected){const item=guardianSystem.find(x=>x.id===id);assert.equal(item.no,no);assert.equal(item.workbench,space);assert.equal(item.role,ability);assert.ok(spiritPresentation[id].responsibility.length>0)}
+ assert.ok(spiritPresentation.qilin.skills.includes('Education'));assert.ok(spiritPresentation.aoyu.skills.includes('Teaching'));assert.ok(spiritPresentation.xuanwu.skills.includes('Security'));
+});
+test('NOVA renders five enterprise headings before personal work and no fabricated records',async()=>{
+ const response=await get('/nova');assert.equal(response.status,200);const html=(await response.text()).replace(/<script[\s\S]*?<\/script>/g,'');
+ let last=-1;for(const item of ['NOW','DECISIONS','RISK','DELIVERY','OPPORTUNITY']){const index=html.indexOf('>'+item+'</h3>');assert.ok(index>last,item);last=index}
+ assert.ok(html.indexOf('个人工作记录')>last);assert.ok(html.includes('不代表企业已批准决策'));assert.ok(html.includes('任务分配、审批及执行尚未开放'));
+});
+test('all spirit routes render for authorized founder and deny anonymous visitors',async()=>{
+ for(const item of guardianSystem.filter(x=>x.id!=='phoenix')){assert.equal((await get('/realms/'+item.id)).status,404);const response=await get('/realms/'+item.id,founder);assert.equal(response.status,200);const html=await response.text();assert.ok(html.includes(item.workbench));assert.ok(html.includes('当前任务与授权证据'))}
+});
+test('legacy and new spirit routes enforce the same limited member scope',async()=>{
+ for(const prefix of ['/realms/','/founder/beasts/']){assert.equal((await get(prefix+'xuanwu',limited)).status,200);assert.equal((await get(prefix+'pixiu',limited)).status,404);assert.equal((await get(prefix+'pixiu',{'oai-authenticated-user-email':'unknown@example.test','oai-authenticated-user-id':'unknown'})).status,404)}
+});
+test('worker routes Canonical reads before legacy D1 and never accepts approval writes',async()=>{
+ const request=(method,headers)=>worker.fetch(new Request('http://localhost/api/meta/canonical/nova',{method,headers}),env,ctx);
+ assert.equal((await request('GET',{})).status,401);const response=await request('GET',founder);assert.equal(response.status,503);assert.equal((await response.json()).code,'CANONICAL_READ_DISABLED');assert.equal((await request('POST',{...founder,'x-founder-approval':'APPROVED'})).status,405);
+});
