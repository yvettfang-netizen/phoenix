@@ -0,0 +1,27 @@
+"use client";
+import { useEffect, useState } from "react";
+import type { SpiritId } from "../spirit-freeze";
+import styles from "./world.module.css";
+
+type Item = {id:string;title:string;module:string;spirit:SpiritId;owner_reference:string;status:string;source_reference:string;source_version:string;verified_at:string;permission_scope:string};
+const modules = ["NOW", "DECISIONS", "RISK", "DELIVERY", "OPPORTUNITY"];
+export function CanonicalProjection({spirit}:{spirit?:SpiritId}) {
+  const [items,setItems]=useState<Item[]>([]),[state,setState]=useState("正在核对授权数据来源…");
+  useEffect(()=>{
+    const controller=new AbortController();
+    setItems([]);
+    fetch(`/api/meta/canonical/${spirit?`spirits/${spirit}`:"nova"}`,{cache:"no-store",signal:controller.signal})
+      .then(async response=>{
+        if(!response.ok) {setState(response.status===401?"登录后查看获授权的业务摘要。":response.status===403?"此账户暂无该范围的查看权限。":"业务摘要尚未接通。当前没有可展示的已核验数据。");return;}
+        const data=await response.json();setItems(data.items);setState(data.items.length?"以下为已核对来源的授权摘要；建议与待审批事项保留各自状态。":"此权限范围内暂无可展示的已核验数据。");
+      }).catch(()=>{if(!controller.signal.aborted)setState("业务摘要暂不可用，请稍后重试。");});
+    return ()=>controller.abort();
+  },[spirit]);
+  return <section className={styles.novaSurface} aria-label={spirit?"获授权的专业任务与证据":"NOVA Hall 授权业务摘要"}>
+    <h2>{spirit?"当前任务与授权证据":"此刻的企业事项"}</h2><p className={styles.quietNote} role="status">{state}</p>
+    {(spirit?["TASKS"]:modules).map(module=><div key={module}><h3>{module==="TASKS"?"任务 · 负责人 · 阻塞 · 来源":module}</h3>
+      <ol className={styles.novaList}>{items.filter(item=>spirit||item.module===module).map(item=><li key={item.id}><div><h4>{item.title}</h4><p>{item.status} · {item.owner_reference}</p><details><summary>查看来源与授权范围</summary><p>source_reference: {item.source_reference}</p><p>source_version: {item.source_version}</p><p>verified_at: {item.verified_at}</p><p>permission_scope: {item.permission_scope}</p><p>status: {item.status}</p></details></div></li>)}</ol>
+    </div>)}
+    <p className={styles.quietNote}>任务分配、审批及执行尚未开放。专业建议经凤凰综合后，交由 Founder 决定。</p>
+  </section>;
+}
