{
  "name": "phoenix-nova-website-v5",
  "version": "5.0.0-candidate.2",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "node:build": "vite build --config vite.node.config.ts",
    "node:start": "vinext start -H 127.0.0.1 -p 4315",
    "node:test": "node --import ./tests/register-typescript.mjs --test tests/node-deployment.test.mjs",
    "node:smoke": "node tests/node-deployment-smoke.mjs",
    "test": "npm run build && node --import ./tests/register-typescript.mjs --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.67.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.4.3",
    "vite": "8.3.5",
    "wrangler": "4.157.0"
  },
  "type": "module",
  "displayName": "Phoenix Nova website V5",
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  },
  "packageManager": "npm@10.9.2"
}
